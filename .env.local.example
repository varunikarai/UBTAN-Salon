# Copy this file to .env.local and fill in your local values.
# This file is intended for private local development use and should not be committed.

# Example local-only values
# PORT=4000
# DATABASE_URL=sqlite:///tmp/ubtan.db

# Required in production. Gates owner-only writes (add/remove services and
# gallery items) on the API. Set to a long random string and keep it secret;
# never commit the real value. The site's owner enters this same value when
# prompted for the "owner access code" in the browser.
OWNER_ACCESS_TOKEN=change-me

# Production only. Restricts CORS to your real site origin instead of
# allowing every cross-origin request.
# ALLOWED_ORIGIN=https://ubtansalon.com
